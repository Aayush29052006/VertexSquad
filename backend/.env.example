# CareerNexus — backend environment variables
# Copy this file to `.env` in the same folder and fill in the real values.
# NEVER commit the real .env — it is gitignored for a reason.

# --- Supabase project ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Database ---
# Use the CONNECTION POOLER URI from:
#   Supabase dashboard -> Settings -> Database -> Connection Pooling -> URI
# Note: the username is postgres.<project-ref> (not just "postgres") and the
# port is 6543. Do NOT use the "Direct connection" string
# (db.<project-ref>.supabase.co:5432) — it is IPv6-only and will fail to
# resolve on most networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Offline fallback — if DATABASE_URL is left blank or unset, the app
# automatically uses a local SQLite file (careernexus.db) so development
# works with no network access.

# --- Google Gemini (free tier is fine) ---
# Get a key at https://aistudio.google.com/apikey — it should start with "AIza".
# If this is missing or invalid, resume parsing falls back to rule-based
# keyword extraction instead of AI.
GEMINI_API_KEY=<your-gemini-api-key>

# --- JWT signing secret ---
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<your-random-secret>
