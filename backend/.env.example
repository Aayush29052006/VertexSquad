# CareerNexus — backend environment variables
# Copy this file to `.env` in the same folder and fill in the real values.
# NEVER commit the real .env — it is gitignored for a reason.

# --- Supabase project ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Database ---
# Use the CONNECTION POOLER URI from:
#   Supabase dashboard -> Settings -> Database -> Connection Pooling -> URI
# Note: the username is postgres.<project-ref> (not just "postgres") and the
# port is 6543. Do NOT use the "Direct connection" string
# (db.<project-ref>.supabase.co:5432) — it is IPv6-only and will fail to
# resolve on most networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Offline fallback — if DATABASE_URL is left blank or unset, the app
# automatically uses a local SQLite file (careernexus.db) so development
# works with no network access.

# --- Google Gemini (free tier is fine) ---
# Get a key at https://aistudio.google.com/apikey — it should start with "AIza".
# If this is missing or invalid, resume parsing falls back to rule-based
# keyword extraction instead of AI.
GEMINI_API_KEY=<your-gemini-api-key>

# --- Google Sign-In ---
# This MUST be the exact same Client ID as GOOGLE_CLIENT_ID in js/config.js.
# There is only ONE OAuth client for this project — do not create a second
# one. If you need to change it, update it in BOTH files together, or
# sign-in will fail with a generic "Google sign-in failed" error (the token
# Google issues won't match the audience this backend expects).
# Create/find it at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<same-value-as-js/config.js>

# --- JWT signing secret ---
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left unset the app runs with an insecure hard-coded dev key and prints a
# warning — fine for local dev, never for a deployment.
JWT_SECRET_KEY=<your-random-secret>

# --- CORS ---
# Comma-separated list of the exact origins allowed to call this API from a
# browser. Defaults (when unset) cover local dev on ports 5500 and 3000.
# Add your deployed frontend origin here before going live.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Admin panel ---
# Comma-separated emails that are promoted to role="admin" on every startup,
# so there is always a way into /api/admin/* and the admin panel. Everyone
# else signs up as a normal student and can only be promoted by an admin.
ADMIN_EMAILS=aayushswapnali@gmail.com
